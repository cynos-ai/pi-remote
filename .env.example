# S01 local server defaults. Never commit real credentials or auth files.
PI_REMOTE_HOST=127.0.0.1
PI_REMOTE_PORT=8080
PI_REMOTE_STATE_DIR=./.local/state
PI_REMOTE_PI_DIR=./.local/pi
PI_REMOTE_WORKSPACE_ROOT=./.local/workspaces
PI_REMOTE_OWNER_ID=owner
PI_REMOTE_OWNER_NAME=Owner
PI_REMOTE_PAIRING_TTL_SECONDS=600
# Use a deployment-only random value in production.
PI_REMOTE_CURSOR_SECRET=development-only-cursor-secret
PI_REMOTE_LIVE_TESTS=0

# S12 Docker / Compose defaults. Set a secret and host-owned workspace path in
# the deployment's private .env before connecting a real device.
NPM_REGISTRY=https://registry.npmmirror.com
DOCKER_REGISTRY_MIRROR=docker.m.daocloud.io
DEBIAN_MIRROR=https://mirrors.aliyun.com
NODE_IMAGE_TAG=24.19.0-bookworm-slim
PI_REMOTE_IMAGE=pi-remote:local
PI_REMOTE_UID=1000
PI_REMOTE_GID=1000
PI_REMOTE_WORKSPACE_HOST=../.local/workspaces
PI_REMOTE_HTTP_PORT=8080
PI_REMOTE_HTTPS_PORT=8443
PI_REMOTE_DOMAIN=localhost
PI_REMOTE_MAX_ACTIVE_RUNS=
PI_REMOTE_MAX_LOADED_WORKERS=
PI_REMOTE_MAX_QUEUED_COMMANDS=
PI_REMOTE_WORKER_IDLE_SECONDS=0
PI_REMOTE_SERIALIZE_WORKSPACE=0
PI_REMOTE_ALLOWED_ORIGINS=
PI_REMOTE_DEFAULT_PROVIDER=
PI_REMOTE_DEFAULT_MODEL=
PI_REMOTE_MODEL_HEALTH_URL=
PI_REMOTE_MODEL_TIMEOUT_MS=15000
PI_REMOTE_LOG_MAX_SIZE=10m
PI_REMOTE_LOG_MAX_FILES=3
PI_REMOTE_GATEWAY_LOG_MAX_SIZE=10m
PI_REMOTE_GATEWAY_LOG_MAX_FILES=3
