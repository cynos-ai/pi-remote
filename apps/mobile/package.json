{
  "name": "@pi-remote/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "expo export --platform all --output-dir ../../test-results/s01-mobile-export",
    "build:android": "expo export --platform android --output-dir ../../test-results/s01-mobile-android",
    "build:ios": "expo export --platform ios --output-dir ../../test-results/s01-mobile-ios",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.15",
    "@pi-remote/protocol": "workspace:*",
    "expo": "57.0.22",
    "expo-file-system": "57.0.7",
    "expo-secure-store": "57.0.4",
    "expo-sqlite": "57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "0.21.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "babel-preset-expo": "57.0.11",
    "typescript": "6.0.3"
  }
}
